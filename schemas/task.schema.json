{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LaurentFough/ZHaiCode/schemas/task.schema.json",
  "title": "ZHaiCode task v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "objective",
    "status",
    "generation",
    "lease",
    "latest_checkpoint"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "QUEUED",
        "CLAIMED",
        "ACTIVE",
        "BLOCKED",
        "PAUSED",
        "READY_FOR_REVIEW",
        "ORPHANED",
        "RECOVERABLE",
        "RECOVERY_REQUIRED"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "lease": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "task_id",
            "machine_id",
            "agent_id",
            "generation",
            "acquired_at",
            "heartbeat_at",
            "expires_at"
          ],
          "properties": {
            "schema_version": {
              "const": "0.1"
            },
            "task_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "machine_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "agent_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "acquired_at": {
              "type": "string",
              "format": "date-time"
            },
            "heartbeat_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_checkpoint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
