{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LaurentFough/ZHaiCode/schemas/project.schema.json",
  "title": "ZHaiCode project v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "name",
    "repository_url",
    "default_branch",
    "instructions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repository_url": {
      "type": "string",
      "minLength": 1
    },
    "default_branch": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
